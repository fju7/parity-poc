# git (backend/data/whatholdsup/corrections.json); Signal's belongs there too.
!backend/data/signal/corrections.json

# Test bills (NEVER commit real medical bills)
data/test-bills/

# Python virtual environment
backend/venv/

# Node modules
node_modules/
frontend/node_modules/

# Environment variables
.env
.env.local
.env.staging

# Generated files
backend/migrations/run_all_migrations.sql

