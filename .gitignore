# CMS raw data files (too large for git)
data/cms-pfs/
data/cms-opps/
data/cms-clfs/

# Employer benchmark raw Excel files (compiled JSON is what the code uses)
backend/data/employer_benchmarks/*.xlsx

# Signal pipeline data (lives in Supabase, not git)
data/signal/sources/
backend/data/signal/*
# ...but the corrections record is not scraped content, it is the account of
# what we got wrong and how we checked it. whatholdsup keeps its equivalent in
# git (backend/data/whatholdsup/corrections.json); Signal's belongs there too.
!backend/data/signal/corrections.json

# Test bills (NEVER commit real medical bills)
data/test-bills/

# Python virtual environment
backend/venv/

# Node modules
node_modules/
frontend/node_modules/

# Environment variables
.env
.env.local
.env.staging

# Generated files
backend/migrations/run_all_migrations.sql

# Mac system files
.DS_Store

# Python cache
__pycache__/
*.pyc

# Build outputs
frontend/dist/
.vercel
backend/data/pfs_rates_2024.csv
backend/data/pfs_rates_2025.csv
.claude/

# Generated ops board. Local only — it carries subscriber data.
backend/data/whatholdsup/dashboard.html
