# Generated ops board. Local only — it carries subscriber data.
backend/data/whatholdsup/dashboard.html

# The source library's DOCUMENTS. This repository is public.
#
# The library holds the papers, labels, registry postings and guidelines the
# issues are checked against, so that a sentence can be reopened against the
# bytes it came from. Some of those documents are subscription content — three
# NEJM papers were downloaded through the editor's own access on 2026-09-01 —
# and putting them in a public repository would be republishing them.
#
# The MANIFESTS stay in git: backend/data/whatholdsup/library/index.json and
# library/issues/*.json carry the sha256, the URL, how it was obtained, and
# whether the bytes are the full text, an abstract or a page about it. What we
# hold and what that licenses is the public record; the copyrighted bytes are
# a local archive.
#
# A clone therefore verifies the manifests and re-acquires the documents. Run
#   backend/venv/bin/python3 scripts/whatholdsup/source_store.py <slug> gaps
# to see what is missing.
backend/data/whatholdsup/library/docs/

# WHU reliability study (advisor ruling 3, 2026-10-20; study/whu-reliability/RUN.md).
# The repository is public: audit and ruling logs, and every file that quotes
# source passages, are never committed for a study issue (WHU-P*, WHU-S*).
# They are archived privately; only a sha256 manifest is committed.
# (Two lines each: this git does not match a [PS] class in these patterns.)
issues/WHU-P*/audit/
issues/WHU-S*/audit/
issues/WHU-P*/rulings/
issues/WHU-S*/rulings/
issues/WHU-P*/export/
issues/WHU-S*/export/
issues/WHU-P*/bindings.json
issues/WHU-S*/bindings.json
issues/WHU-P*/gate-findings.json
issues/WHU-S*/gate-findings.json
issues/WHU-P*/quotations.json
issues/WHU-S*/quotations.json
issues/WHU-P*/conclusion-review.json
issues/WHU-S*/conclusion-review.json
issues/WHU-P*/change-reviews.json
issues/WHU-S*/change-reviews.json
issues/WHU-P*/draft/*.gate.json*
issues/WHU-S*/draft/*.gate.json*
# The source advocate's briefs and adjudications quote source passages too (2026-10-20).
issues/WHU-P*/advocate/
issues/WHU-S*/advocate/

# Local drop folder for incoming files; never committed (2026-10-20).
_incoming/

# The audit stage's private log of rejected reader quotations (raw source text; 2026-10-20).
issues/*/audit/*/quote_rejections.jsonl

# The source advocate's raw quotation checks (source text; 2026-10-20).
issues/*/advocate/quote_checks.jsonl
