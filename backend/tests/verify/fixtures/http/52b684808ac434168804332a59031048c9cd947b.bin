 colspan="1">2,530 (16.7)</td><td valign="top" align="center" rowspan="1" colspan="1">5,065 (16.7)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">≥65 yr</td><td valign="top" align="center" rowspan="1" colspan="1">3,749 (24.7)</td><td valign="top" align="center" rowspan="1" colspan="1">3,763 (24.8)</td><td valign="top" align="center" rowspan="1" colspan="1">7,512 (24.8)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Hispanic or Latino ethnicity — no. of participants (%)<xref rid="t1fn3" ref-type="table-fn"><sup>‡</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Hispanic or Latino</td><td valign="top" align="center" rowspan="1" colspan="1">3,114 (20.5)</td><td valign="top" align="center" rowspan="1" colspan="1">3,121 (20.6)</td><td valign="top" align="center" rowspan="1" colspan="1">6,235 (20.5)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Not Hispanic or Latino</td><td valign="top" align="center" rowspan="1" colspan="1">11,917 (78.6)</td><td valign="top" align="center" rowspan="1" colspan="1">11,918 (78.5)</td><td valign="top" align="center" rowspan="1" colspan="1">23,835 (78.5)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Not reported and unknown</td><td valign="top" align="center" rowspan="1" colspan="1">139 (0.9)</td><td valign="top" align="center" rowspan="1" colspan="1">142 (0.9)</td><td valign="top" align="center" rowspan="1" colspan="1">281 (0.9)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Race or ethnic group — no. of participants (%)<xref rid="t1fn3" ref-type="table-fn"><sup>‡</sup></xref></td><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1"/></tr>