se 2.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of participants","timeFrame":"From Dose 1 to 7 Days After Dose 2","groups":[{"id":"OG000","title":"BNT162b2 (30 mcg): 18-55 Years of Age","description":"Participants aged 18-55 years were randomized to receive 2 doses of 30 microgram BNT162b2 vaccine 250 microgram/0.5 milliliter intramuscularly separated by 21 days interval as part of this study."},{"id":"OG001","title":"Placebo:18-55 Years of Age","description":"Participants were randomized to receive 0.9% sodium chloride solution for injection intramuscularly."},{"id":"OG002","title":"BNT162b2 (30 mcg): 56-85 Years of Age","description":"Participants aged 56-85 years were randomized to receive 2 doses of 30 microgram BNT162b2 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"OG003","title":"Placebo: 56 to 85 Years of Age","description":"Participants were randomized to receive 0.9% sodium chloride solution for injection intramuscularly."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"88"},{"groupId":"OG001","value":"90"},{"groupId":"OG002","value":"92"},{"groupId":"OG003","value":"90"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"9.1","lowerLimit":"4.0","upperLimit":"17.1"},{"groupId":"OG001","value":"6.7","lowerLimit":"3.5","upperLimit":"11.4"},{"groupId":"OG002","value":"4.3","lowerLimit":"1.2","upperLimit":"10.8"},{"groupId":"OG003","value":"10.0","lowerLimit":"6.0","upperLimit":"15.3"}]}]}]},{"type":"PRIMARY","title":"Percentage of Participants Reporting Serious Adverse Events From Dose 1 to 7 Days After Dose 2: Phase 2","description":"A SAE was any untoward medical occurrence that occurred, at any dose: resulted in death; required inpatient hospitalization or prolongation of existing hospitalization; was life-threatening; resulted in persistent or significant disability/ incapacity; was a congenital anomaly/birth defect and other important medical events.","populationDescription":"Safety population included all randomized participants who received at least 1 dose of the study intervention. Here, ''N'' signifies the participant was in the safety population and had e-diary data after Dose 2.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of participants","timeFrame":"From Dose 1 to 7 Days After Dose 2","groups":[{"id":"OG000","title":"BNT162b2 (30 mcg): 18-55 Years of Age","description":"Participants aged 18-55 years were randomized to receive 2 doses of 30 microgram BNT162b2 vaccine 250 microgram/0.5 milliliter intramuscularly separated by 21 days interval as part of this study."},{"id":"OG001","title":"Placebo:18-55 Years of Age","description":"Participants were randomized to receive 0.9% sodium chloride solution for injection intramuscularly."},{"id":"OG002","title":"BNT162b2 (30 mcg): 56-85 Years of Age","description":"Participants aged 56-85 years were randomized to receive 2 doses of 30 microgram BNT162b2 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"OG003","title":"Placebo: 56 to 85 Years of Age","description":"Participants were randomized to receive 0.9% sodium chloride solution for injection intramuscularly."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"88"},{"groupId":"OG001","value":"90"},{"groupId":"OG002","value":"92"},{"groupId":"OG003","value":"90"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"1.1","lowerLimit":"0.0","upperLimit":"6.2"},{"groupId":"OG001","value":"0.6","lowerLimit":"0.0","upperLimit":"3.1"},{"groupId":"OG002","value":"0","lowerLimit":"0.0","upperLimit":"3.9"},{"groupId":"OG003","value":"0","lowerLimit":"0.0","upperLimit":"2.0"}]}]}]},{"type":"PRIMARY","title":"Percentage of Participants With Local R