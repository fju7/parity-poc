{"protocolSection":{"identificationModule":{"nctId":"NCT04368728","orgStudyIdInfo":{"id":"C4591001"},"secondaryIdInfos":[{"id":"2020-002641-42","type":"EUDRACT_NUMBER"}],"organization":{"fullName":"BioNTech SE","class":"INDUSTRY"},"briefTitle":"Study to Describe the Safety, Tolerability, Immunogenicity, and Efficacy of RNA Vaccine Candidates Against COVID-19 in Healthy Individuals","officialTitle":"A PHASE 1/2/3, PLACEBO-CONTROLLED, RANDOMIZED, OBSERVER-BLIND, DOSE-FINDING STUDY TO EVALUATE THE SAFETY, TOLERABILITY, IMMUNOGENICITY, AND EFFICACY OF SARS-COV-2 RNA VACCINE CANDIDATES AGAINST COVID-19 IN HEALTHY INDIVIDUALS"},"statusModule":{"statusVerifiedDate":"2026-03","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2020-04-29","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2023-02-10","type":"ACTUAL"},"completionDateStruct":{"date":"2023-02-10","type":"ACTUAL"},"studyFirstSubmitDate":"2020-04-27","studyFirstSubmitQcDate":"2020-04-29","studyFirstPostDateStruct":{"date":"2020-04-30","type":"ACTUAL"},"resultsFirstSubmitDate":"2024-02-09","resultsFirstSubmitQcDate":"2026-03-03","resultsFirstPostDateStruct":{"date":"2026-03-25","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-03-03","lastUpdatePostDateStruct":{"date":"2026-03-25","type":"ACTUAL"}},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2","PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"PREVENTION","maskingInfo":{"masking":"TRIPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR"]}},"enrollmentInfo":{"count":46969,"type":"ACTUAL"}}},"resultsSection":{"participantFlowModule":{"preAssignmentDetails":"A total of 46934 participants were randomized and assigned to the treatment. The study consisted of 2 parts. Phase 1: to identify preferred vaccine candidate and dose level of candidate vaccine; Phase 2/3: an expanded cohort and efficacy part.","groups":[{"id":"FG000","title":"Phase 1:BNT162b1 10 mcg Dose: 18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 2 doses of 10 microgram BNT162b1 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"FG001","title":"Phase 1:BNT162b1 20 mcg Dose:18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 2 doses of 20 microgram BNT162b1 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"FG002","title":"Phase 1:BNT162b1 30 mcg Dose:18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 2 doses of 30 microgram BNT162b1 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"FG003","title":"Phase1:BNT162b1 100 mcg Dose:18-55 Years of Age","description":"Participants aged 18-55 years were randomized to receive 2 doses of 100 microgram BNT162b1 vaccine (250 microgram/0.5 milliliter) intramuscularly and received only 1 dose due to reactogenicity."},{"id":"FG004","title":"Phase 1: Placebo: 18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 0.9% sodium chloride solution for Injection intramuscularly."},{"id":"FG005","title":"Phase 1: BNT162b2: 10 mcg Dose: 18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 2 doses of 10 microgram BNT162b2 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"FG006","title":"Phase 1: BNT162b2: 20 mcg Dose: 18-85 Years of Age","description":"Participants aged 18-85 years were randomized to receive 2 doses of 20 microgram BNT162b2 vaccine (250 microgram/0.5 milliliter) intramuscularly separated by 21 days interval as part of this study."},{"id":"FG007","title":"Phase 1: BNT162b2: 30 mcg Dose: 18-85 Years of Age","description":"Participants aged 18-