{"protocolSection":{"identificationModule":{"nctId":"NCT01740427","orgStudyIdInfo":{"id":"A5481008"},"secondaryIdInfos":[{"id":"2012-004601-27","type":"EUDRACT_NUMBER"},{"id":"PALMOA-2","type":"OTHER","domain":"Alias Study Number"},{"id":"PALOMA-2","type":"OTHER","domain":"Alias Study Number"}],"organization":{"fullName":"Pfizer","class":"INDUSTRY"},"briefTitle":"A Study of Palbociclib (PD-0332991) + Letrozole vs. Letrozole For 1st Line Treatment Of Postmenopausal Women With ER+/HER2- Advanced Breast Cancer (PALOMA-2)","officialTitle":"A RANDOMIZED, MULTICENTER, DOUBLE-BLIND PHASE 3 STUDY OF PD-0332991 (ORAL CDK 4/6 INHIBITOR) PLUS LETROZOLE VERSUS PLACEBO PLUS LETROZOLE FOR THE TREATMENT OF POSTMENOPAUSAL WOMEN WITH ER (+), HER2 (-) BREAST CANCER WHO HAVE NOT RECEIVED ANY PRIOR SYSTEMIC ANTI CANCER TREATMENT FOR ADVANCED DISEASE"},"statusModule":{"statusVerifiedDate":"2024-10","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2013-02-22","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2016-02-26","type":"ACTUAL"},"completionDateStruct":{"date":"2023-11-09","type":"ACTUAL"},"studyFirstSubmitDate":"2012-11-26","studyFirstSubmitQcDate":"2012-11-30","studyFirstPostDateStruct":{"date":"2012-12-04","type":"ESTIMATED"},"resultsFirstSubmitDate":"2016-10-21","resultsFirstSubmitQcDate":"2017-03-16","resultsFirstPostDateStruct":{"date":"2017-04-26","type":"ACTUAL"},"lastUpdateSubmitDate":"2024-10-22","lastUpdatePostDateStruct":{"date":"2024-11-14","type":"ACTUAL"}},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":666,"type":"ACTUAL"}}},"resultsSection":{"participantFlowModule":{"preAssignmentDetails":"The study consisted of a screening visit within 28 days before randomization, an active treatment phase, divided in cycles of 28 days each, and a post-treatment follow-up period during which survival and new anti-cancer therapy information was collected every 6 months (±7 days) from the last dose of study treatment.","recruitmentDetails":"A total of 666 participants were randomized at 239 centers in 19 countries.","groups":[{"id":"FG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"FG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"periods":[{"title":"Overall Study","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","numSubjects":"444"},{"groupId":"FG001","numSubjects":"222"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"0"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"444"},{"groupId":"FG001","numSubjects":"222"}]}],"dropWithdraws":[{"type":"Objective Progression or Relapse","reasons":[{"groupId":"FG000","numSubjects":"286"},{"groupId":"FG001","numSubjects":"172"}]},{"type":"Adverse Event","reasons":[{"groupId":"FG000","numSubjects":"32"},{"groupId":"FG001","numSubjects":"9"}]},{"type":"Global Deterioration of Health Status","reasons":[{"groupId":"FG000","numSubjects":"28"},{"groupId":"FG001","numSubjects":"12"}]},{"type":"Participant Refused Continued Treatment","reasons":[{"groupId":"FG000","numSubjects":"27"},{"groupId":"FG001","numSubjects":"15"}]},{"type":"Unspecified reasons","reasons":[{"groupId":"FG000","numSubjects":"52"},{"groupId":"FG001","numSubjects":"8"}]},{"type":"Death","reasons":[{"groupId":"FG000","numSubjects":"10"},{"groupId":"FG001","numSubjects":"3"}]},{"type":"Protocol Violation","reasons":[{"groupId":"FG000","numSubjects":"5"},{"groupId":"FG001","numSubjects":"3"}]},{"type":"Lost to Follow-up","reasons":[{"groupId":"FG000","numSubjects":"3"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"Site Terminated by Sponsor","reasons":[{"groupId":"FG000","numSubjects":"1"},{"groupId":"FG001","numSubjects":"0"}]}]}]},"baselineCharacteristicsModule":{"populationDescription":"The intent-to-treat (ITT) population included all participants who were randomized, with study drug assignment designated according to initial randomization, regardless of whether participants received study drug or received a different drug from that to which they were randomized.","groups":[{"id":"BG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"BG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"BG002","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"444"},{"groupId":"BG001","value":"222"},{"groupId":"BG002","value":"666"}]}],"measures":[{"title":"Age, Continuous","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"Years","classes":[{"categories":[{"measurements":[{"groupId":"BG000","value":"61.7","spread":"10.6"},{"groupId":"BG001","value":"60.6","spread":"11.2"},{"groupId":"BG002","value":"61.3","spread":"10.8"}]}]}]},{"title":"Sex: Female, Male","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Female","measurements":[{"groupId":"BG000","value":"444"},{"groupId":"BG001","value":"222"},{"groupId":"BG002","value":"666"}]},{"title":"Male","measurements":[{"groupId":"BG000","value":"0"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"0"}]}]}]}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"PRIMARY","title":"Progression-Free Survival (PFS) as Assessed by the Investigator","description":"PFS is defined as the time from the date of randomization to the date of the first documentation of objective tumor progression as per Response Evaluation Criteria In Solid Tumors Criteria (RECIST v1.1) or death due to any cause in the absence of documented PD, whichever occurs first. If tumor progression data include more than 1 date, the first date will be used. PFS (in months) will be calculated as (first event date - randomization date +1)/30.4. Progression is defined using RECIST v1.1, as a 20% increase in the sum of diameters of target measurable lesions above the smallest sum observed (over baseline if no decrease in the sum is observed during therapy), with a minimum absolute increase of 5 mm, or unequivocal progression of pre-existing non-target lesions, or the appearance of new lesions.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study drug assignment designated according to initial randomization, regardless of whether participants received study medication or received a different drug from that to which they were randomized.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"From randomization date to date of first documentation of progression or death (up to approximately 2.5 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"24.8","lowerLimit":"22.1","upperLimit":"NA","comment":"The value was not available because there was not enough disease progression events in the treatment group at the time of analysis, due to drug benefit."},{"groupId":"OG001","value":"14.5","lowerLimit":"12.9","upperLimit":"17.1"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.000001","pValueComment":"1-sided p-value from the stratified log-rank test.","statisticalMethod":"Stratified Log Rank","paramType":"Hazard Ratio (HR)","paramValue":"0.576","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.463","ciUpperLimit":"0.718"}]},{"type":"SECONDARY","title":"Objective Response as Assessed by the Investigator","description":"Objective Response (OR) defined as overall complete response (CR) or partial response (PR) according to RECIST v1.1. Objective Response Rate (ORR) is defined as proportion of participants with CR or PR relative to all randomized participants with measurable disease at baseline. Participants who do not have on-study radiographic tumor re-evaluation, who received anti-tumor treatment, or who died, progressed/ dropped out for any reason prior to reaching a CR or PR were counted as non-responders in assessment of ORR. Per RECIST v1.1, CR: Complete disappearance of target lesions with exception of nodal disease. All target nodes must decrease to normal size (short axis \\<10mm). PR: \\>=30% decrease under baseline of the sum of diameters of all target measurable lesions. The short diameter is used in the sum for target nodes, while the longest diameter is used in the sum for all other target lesions. Stable Disease: neither sufficient shrinkage nor increase to qualify for disease progression.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study medication, regardless of whether participants received study medication or received a different drug from that to which they were randomized.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of participants","timeFrame":"From randomization until end of treatment (up to approximately 2.5 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"46.4","lowerLimit":"41.7","upperLimit":"51.2"},{"groupId":"OG001","value":"38.3","lowerLimit":"31.9","upperLimit":"45.0"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Stratified analysis: Stratified by disease site (visceral vs non-visceral) per randomization.","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0224","pValueComment":"1-sided p-value is from exact test.","statisticalMethod":"Fisher Exact","paramType":"Odds Ratio (OR)","paramValue":"1.428","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"1.008","ciUpperLimit":"2.030"}]},{"type":"SECONDARY","title":"Objective Response: Participants With Measurable Disease at Baseline as Assessed by the Investigator","description":"The OR is defined as the overall CR or PR according to the RECIST v1.1. ORR is defined as proportion of participants with CR or PR relative to all randomized participants with measurable disease at baseline. Participants who do not have on-study radiographic tumor re-evaluation, who received anti-tumor treatment, or who died, progressed/ dropped out for any reason prior to reaching a CR or PR were counted as non-responders in the assessment of ORR. Per RECIST v1.1, CR: Complete disappearance of target lesions with exception of nodal disease. All target nodes must decrease to normal size (short axis \\<10mm). PR: \\>=30% decrease under baseline of the sum of diameters of all target measurable lesions. The short diameter is used in the sum for target nodes, while the longest diameter is used in the sum for all other target lesions. Stable Disease: neither sufficient shrinkage nor increase to qualify for disease progression.","populationDescription":"Participants who had measurable disease at baseline.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of participants","timeFrame":"From randomization until end of treatment (up to approximately 2.5 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"338"},{"groupId":"OG001","value":"171"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"60.7","lowerLimit":"55.2","upperLimit":"65.9"},{"groupId":"OG001","value":"49.1","lowerLimit":"41.4","upperLimit":"56.9"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Stratified analysis: Stratified by disease site (visceral vs non-visceral) per randomization.","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0090","pValueComment":"1-sided p-value is from exact test.","statisticalMethod":"Fisher Exact","paramType":"Odds Ratio (OR)","paramValue":"1.594","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"1.080","ciUpperLimit":"2.347"}]},{"type":"SECONDARY","title":"Duration of Response (DR)","description":"DR is defined as the time from the first documentation of objective tumor response (CR or PR) to the first documentation of disease progression or to death due to any cause, whichever occurs first. If tumor progression data included more than 1 date, the first date will be used. DR was calculated as \\[the date response ended (i.e. date of PD or death) - first CR or PR date + 1)\\]/30.4. DR would only be calculated for the subgroup of participants with an objective tumor response. Per RECIST v1.1, CR: Complete disappearance of target lesions with exception of nodal disease. All target nodes must decrease to normal size (short axis \\<10mm). PR: \\>=30% decrease under baseline of the sum of diameters of all target measurable lesions.The short diameter is used in the sum for target nodes, while the longest diameter is used in the sum for all other target lesions. Stable Disease: neither sufficient shrinkage nor increase to qualify for disease progression.","populationDescription":"Participants who had tumor response with CR or PR during study.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"From randomization until end of treatment (up to approximately 2.5 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"206"},{"groupId":"OG001","value":"85"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"20.1","lowerLimit":"19.3","upperLimit":"28.0"},{"groupId":"OG001","value":"16.7","lowerLimit":"13.8","upperLimit":"22.5"}]}]}]},{"type":"SECONDARY","title":"Disease Control (DC)/Clinical Benefit Response (CBR)","description":"DC is defined as overall CR, PR, or stable disease (SD) \\>=24 weeks according to RECIST version 1.1. Disease Control Rate (DCR) is defined as participants with CR, PR, or SD \\>=24 weeks relative to all randomized participants. Participants who do not have on-study radiographic tumor reevaluation, who received anti-tumor treatment, a best response of SD\\>=24 weeks, or who died, progressed, or dropped out for any reason prior to achieving reaching a CR or PR and a best response of SD\\>=24 weeks was counted as non-responders in DCR. Per RECIST v1.1, CR: Complete disappearance of target lesions with exception of nodal disease. All target nodes must decrease to normal size (short axis \\<10mm). PR: \\>=30% decrease under baseline of the sum of diameters of all target measurable lesions. The short diameter is used in the sum for target nodes, while the longest diameter is used in the sum for all other target lesions. SD: neither sufficient shrinkage nor increase to qualify for disease progression.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study medication, regardless of whether participants received study medication or received a different drug from that to which they were randomized.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of participants","timeFrame":"From randomization until end of treatment (up to approximately 2.5 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"85.8","lowerLimit":"82.2","upperLimit":"88.9"},{"groupId":"OG001","value":"71.2","lowerLimit":"64.7","upperLimit":"77.0"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Stratified analysis: Stratified by disease site (visceral, non-visceral) per randomization.","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","pValueComment":"1-sided p-value is from exact test.","statisticalMethod":"Fisher Exact","paramType":"Odds Ratio (OR)","paramValue":"2.451","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"1.619","ciUpperLimit":"3.722"}]},{"type":"SECONDARY","title":"PFS by Tumor Tissue Biomarkers Status, Including Genes (eg, Copy Numbers of CCND1, CDKN2A), Proteins (eg, Ki67, pRb), and RNA Expression (eg, cdk4, cdk6)","description":"PFS by biomarker status by Investigator assessment. Progression is defined using RECIST v1.1, as a 20% increase in the sum of the longest diameter of target lesions, or a measurable increase in a non-target lesion, or the appearance of new lesions. Positive is defined as H-Score \\>=1 and negative as H-Score \\<1. H-Score is calculated as the sum of the % of cells at each level of staining intensity (0, 1+, 2+, and 3+) multiplied by the staining intensity value: H-Score = (% at 0)\\*0 + (% at 1+)\\*1 + (% at 2+)\\*2 + (% at 3+)\\*3. H-Score values range from 0 to 300. ER stands for estrogen receptor and Rb stands for retinoblastoma susceptibility gene product.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study medication, regardless of whether participants received study medication or received a different drug from that to which they were randomized. Here \"Number Analyzed\" signifies number of participants evaluable for specified rows.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"From randomization until end of treatment (up to approximately 24 Months)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"title":"ER Positive","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"338"},{"groupId":"OG001","value":"166"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"24.9","lowerLimit":"22.2","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."},{"groupId":"OG001","value":"16.3","lowerLimit":"12.9","upperLimit":"19.1"}]}]},{"title":"ER Negative","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"40"},{"groupId":"OG001","value":"22"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"15.6","lowerLimit":"8.3","upperLimit":"22.0"},{"groupId":"OG001","value":"5.4","lowerLimit":"2.7","upperLimit":"11.1"}]}]},{"title":"Rb Positive","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"345"},{"groupId":"OG001","value":"167"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"24.2","lowerLimit":"21.4","upperLimit":"25.7"},{"groupId":"OG001","value":"13.7","lowerLimit":"11.0","upperLimit":"16.5"}]}]},{"title":"Rb Negative","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"29"},{"groupId":"OG001","value":"22"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"NA","lowerLimit":"11.4","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."},{"groupId":"OG001","value":"18.5","lowerLimit":"2.9","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."}]}]},{"title":"Cyclin D1 Positive","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"370"},{"groupId":"OG001","value":"179"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"24.8","lowerLimit":"21.5","upperLimit":"27.6"},{"groupId":"OG001","value":"13.8","lowerLimit":"11.3","upperLimit":"16.8"}]}]},{"title":"Cyclin D1 Negative","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"5"},{"groupId":"OG001","value":"10"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"11.1","lowerLimit":"2.2","upperLimit":"23.9"},{"groupId":"OG001","value":"8.1","lowerLimit":"0.4","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."}]}]},{"title":"p16 Positive","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"305"},{"groupId":"OG001","value":"161"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"24.8","lowerLimit":"21.5","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."},{"groupId":"OG001","value":"13.8","lowerLimit":"11.1","upperLimit":"16.8"}]}]},{"title":"p16 Negative","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"59"},{"groupId":"OG001","value":"25"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"16.8","lowerLimit":"11.1","upperLimit":"24.9"},{"groupId":"OG001","value":"13.8","lowerLimit":"8.1","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."}]}]},{"title":"p16 H-Score<175","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"341"},{"groupId":"OG001","value":"177"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"23.7","lowerLimit":"19.6","upperLimit":"25.7"},{"groupId":"OG001","value":"13.8","lowerLimit":"11.2","upperLimit":"16.8"}]}]},{"title":"p16 H-Score>=175","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"23"},{"groupId":"OG001","value":"9"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"24.2","lowerLimit":"11.1","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."},{"groupId":"OG001","value":"5.6","lowerLimit":"1.5","upperLimit":"19.1"}]}]},{"title":"Ki67 <=20%","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"216"},{"groupId":"OG001","value":"102"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"27.6","lowerLimit":"24.2","upperLimit":"NA","comment":"Not reached; insufficient number of participants with events."},{"groupId":"OG001","value":"16.8","lowerLimit":"13.7","upperLimit":"22.0"}]}]},{"title":"Ki67 >20%","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"152"},{"groupId":"OG001","value":"83"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"17.5","lowerLimit":"13.8","upperLimit":"22.0"},{"groupId":"OG001","value":"8.4","lowerLimit":"5.6","upperLimit":"13.6"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for ER positive","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.571","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.443","ciUpperLimit":"0.737","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for ER Negative","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0030","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.405","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.218","ciUpperLimit":"0.751","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Rb Positive","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.531","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.416","ciUpperLimit":"0.680","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Rb Negative","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.3237","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.675","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.308","ciUpperLimit":"1.481","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Cyclin D1 Positive","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.555","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.437","ciUpperLimit":"0.705","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Cyclin D1 Negative","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.9964","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.997","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.287","ciUpperLimit":"3.461","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for p16 Positive","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.518","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.400","ciUpperLimit":"0.670","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for p16 Negative","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.3221","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.731","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.392","ciUpperLimit":"1.364","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for p16 HScore\\<175","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"<0.0001","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.581","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.455","ciUpperLimit":"0.742","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for p16 HScore\\>=175","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0022","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.255","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.100","ciUpperLimit":"0.650","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Ki67 \\<=20%","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0002","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.530","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.379","ciUpperLimit":"0.742","estimateComment":"Unstratified Cox proportional hazards model was used."},{"groupIds":["OG000","OG001"],"groupDescription":"Statistical analysis for Ki67 \\>20%","nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0007","statisticalMethod":"Unstratified log-rank test","paramType":"Hazard Ratio (HR)","paramValue":"0.569","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.409","ciUpperLimit":"0.791","estimateComment":"Unstratified Cox proportional hazards model was used."}]},{"type":"SECONDARY","title":"Corrected QT Interval (QTc) Time-Matched Change From Baseline on Cycle 1 Day 14","description":"Triplicate 12-lead ECG measurements (each recording separated by approximately 2 minutes) were performed and sent to a central laboratory for blinded manual adjudication. The average was calculated. The time corresponding to beginning of depolarization to repolarization of the ventricles (QT interval) was adjusted for RR interval using QT and RR from each ECG by Fridericia's formula (QTcF = QT divided by cube root of RR), by Bazette's formula (QTcB = QT divided by square root of RR) and corrected QT interval according to study-specific criteria (QTcS). Time-matched change from baseline values were reported for QTc analysis population.","populationDescription":"QTc analysis set is a subset of as treated (AT) population who were in Group 1; their QTc was used to study the effect of palbociclib on QT interval via serial triplicate ECGs with PK draws; and who had \\>= 1 pair of time-matched Day 0 and palbociclib postdose (Cycle1 Day14) measurements.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"90% Confidence Interval","unitOfMeasure":"msec","timeFrame":"Time-matched triplicate ECGs were collected at 0 (predose), 2, 4, 6 and 8 hours on Day 0 and on Cycle1 Day14","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"76"},{"groupId":"OG001","value":"47"}]}],"classes":[{"title":"QTcS at 0 hour","categories":[{"measurements":[{"groupId":"OG000","value":"0.80","lowerLimit":"-1.67","upperLimit":"3.26"},{"groupId":"OG001","value":"2.95","lowerLimit":"-0.19","upperLimit":"6.10"}]}]},{"title":"QTcS at 2 hour","categories":[{"measurements":[{"groupId":"OG000","value":"3.32","lowerLimit":"0.79","upperLimit":"5.85"},{"groupId":"OG001","value":"1.65","lowerLimit":"-1.48","upperLimit":"4.78"}]}]},{"title":"QTcS at 4 hour","categories":[{"measurements":[{"groupId":"OG000","value":"2.76","lowerLimit":"0.23","upperLimit":"5.30"},{"groupId":"OG001","value":"1.74","lowerLimit":"-1.39","upperLimit":"4.87"}]}]},{"title":"QTcS at 6 hour","categories":[{"measurements":[{"groupId":"OG000","value":"4.49","lowerLimit":"1.96","upperLimit":"7.02"},{"groupId":"OG001","value":"0.72","lowerLimit":"-2.41","upperLimit":"3.85"}]}]},{"title":"QTcS at 8 hour","categories":[{"measurements":[{"groupId":"OG000","value":"0.94","lowerLimit":"-1.60","upperLimit":"3.48"},{"groupId":"OG001","value":"3.14","lowerLimit":"0.01","upperLimit":"6.27"}]}]},{"title":"QTcF at 0 hour","categories":[{"measurements":[{"groupId":"OG000","value":"1.10","lowerLimit":"-1.39","upperLimit":"3.58"},{"groupId":"OG001","value":"3.06","lowerLimit":"-0.11","upperLimit":"6.23"}]}]},{"title":"QTcF at 2 hour","categories":[{"measurements":[{"groupId":"OG000","value":"3.68","lowerLimit":"1.12","upperLimit":"6.23"},{"groupId":"OG001","value":"1.73","lowerLimit":"-1.43","upperLimit":"4.88"}]}]},{"title":"QTcF at 4 hour","categories":[{"measurements":[{"groupId":"OG000","value":"2.86","lowerLimit":"0.31","upperLimit":"5.41"},{"groupId":"OG001","value":"1.54","lowerLimit":"-1.62","upperLimit":"4.70"}]}]},{"title":"QTcF at 6 hour","categories":[{"measurements":[{"groupId":"OG000","value":"4.57","lowerLimit":"2.01","upperLimit":"7.12"},{"groupId":"OG001","value":"0.71","lowerLimit":"-2.44","upperLimit":"3.87"}]}]},{"title":"QTcF at 8 hour","categories":[{"measurements":[{"groupId":"OG000","value":"1.21","lowerLimit":"-1.36","upperLimit":"3.77"},{"groupId":"OG001","value":"2.84","lowerLimit":"-0.31","upperLimit":"6.00"}]}]},{"title":"QTcB at 0 hour","categories":[{"measurements":[{"groupId":"OG000","value":"-0.11","lowerLimit":"-2.83","upperLimit":"2.61"},{"groupId":"OG001","value":"2.78","lowerLimit":"-0.69","upperLimit":"6.25"}]}]},{"title":"QTcB at 2 hour","categories":[{"measurements":[{"groupId":"OG000","value":"1.46","lowerLimit":"-1.34","upperLimit":"4.25"},{"groupId":"OG001","value":"0.83","lowerLimit":"-2.63","upperLimit":"4.28"}]}]},{"title":"QTcB at 4 hour","categories":[{"measurements":[{"groupId":"OG000","value":"2.58","lowerLimit":"-0.22","upperLimit":"5.38"},{"groupId":"OG001","value":"2.47","lowerLimit":"-0.98","upperLimit":"5.92"}]}]},{"title":"QTcB at 6 hour","categories":[{"measurements":[{"groupId":"OG000","value":"4.03","lowerLimit":"1.24","upperLimit":"6.83"},{"groupId":"OG001","value":"0.53","lowerLimit":"-2.92","upperLimit":"3.99"}]}]},{"title":"QTcB at 8 hour","categories":[{"measurements":[{"groupId":"OG000","value":"-0.17","lowerLimit":"-2.98","upperLimit":"2.64"},{"groupId":"OG001","value":"4.14","lowerLimit":"0.69","upperLimit":"7.59"}]}]}]},{"type":"SECONDARY","title":"Percentage of Participants With Corrected QT Interval (QTc)","description":"Triplicate 12-lead ECG measurements (each recording separated by approximately 2 minutes) were performed and sent to a central laboratory for blinded manual adjudication. The average was calculated. The time corresponding to beginning of depolarization to repolarization of the ventricles (QT interval) was adjusted for RR interval using QT and RR from each ECG by Fridericia's formula (QTcF = QT divided by cube root of RR), by Bazette's formula (QTcB = QT divided by square root of RR) and corrected QT interval according to study-specific criteria (QTcS). Percentage of participants with post-baseline maximum absolute values and maximum increase from baseline were summarized for the safety analysis population.","populationDescription":"The AT population or safety analysis set included all participants who received at least 1 dose of study medication, with treatment assignments designated according to actual study treatment received.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"Percentage of participants","timeFrame":"For safety monitoring triplicate ECGs were obtained at 0 hour (pre-dose) on Day 1 of Cycle 1, Day 14 of Cycles 1 and Cycle 2, then on Day 1 of Cycles 4, 7, and 10 (ECGs beyond Cycle 10 were performed as clinically indicated)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"441"},{"groupId":"OG001","value":"220"}]}],"classes":[{"title":"Maximum QTcS <450 msec","categories":[{"measurements":[{"groupId":"OG000","value":"80.5"},{"groupId":"OG001","value":"85.9"}]}]},{"title":"Maximum QTcS 450-<480 msec","categories":[{"measurements":[{"groupId":"OG000","value":"17.9"},{"groupId":"OG001","value":"11.8"}]}]},{"title":"Maximum QTcS 480-<500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"1.1"},{"groupId":"OG001","value":"2.3"}]}]},{"title":"Maximum QTcS >=500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.5"},{"groupId":"OG001","value":"0"}]}]},{"title":"Maximum QTcF <450 msec","categories":[{"measurements":[{"groupId":"OG000","value":"85.9"},{"groupId":"OG001","value":"89.5"}]}]},{"title":"Maximum QTcF 450-<480 msec","categories":[{"measurements":[{"groupId":"OG000","value":"12.2"},{"groupId":"OG001","value":"9.5"}]}]},{"title":"Maximum QTcF 480-<500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"1.6"},{"groupId":"OG001","value":"0.9"}]}]},{"title":"Maximum QTcF >=500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.2"},{"groupId":"OG001","value":"0"}]}]},{"title":"Maximum QTcB <450 msec","categories":[{"measurements":[{"groupId":"OG000","value":"64.9"},{"groupId":"OG001","value":"69.1"}]}]},{"title":"Maximum QTcB 450-<480 msec","categories":[{"measurements":[{"groupId":"OG000","value":"32.2"},{"groupId":"OG001","value":"27.3"}]}]},{"title":"Maximum QTcB 480-<500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"2.3"},{"groupId":"OG001","value":"3.2"}]}]},{"title":"Maximum QTcB >=500 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.7"},{"groupId":"OG001","value":"0.5"}]}]},{"title":"Maximum QTcS Change <30 msec","categories":[{"measurements":[{"groupId":"OG000","value":"92.7"},{"groupId":"OG001","value":"94.5"}]}]},{"title":"Maximum QTcS 30<=Change <60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"6.6"},{"groupId":"OG001","value":"5.5"}]}]},{"title":"Maximum QTcS Change>=60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.7"},{"groupId":"OG001","value":"0"}]}]},{"title":"Maximum QTcF Change <30 msec","categories":[{"measurements":[{"groupId":"OG000","value":"91.6"},{"groupId":"OG001","value":"93.6"}]}]},{"title":"Maximum QTcF 30<=Change <60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"7.9"},{"groupId":"OG001","value":"6.4"}]}]},{"title":"Maximum QTcF Change>=60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.5"},{"groupId":"OG001","value":"0"}]}]},{"title":"Maximum QTcB Change <30 msec","categories":[{"measurements":[{"groupId":"OG000","value":"88.9"},{"groupId":"OG001","value":"91.4"}]}]},{"title":"Maximum QTcB 30<=Change <60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"10.2"},{"groupId":"OG001","value":"8.2"}]}]},{"title":"Maximum QTcB Change>=60 msec","categories":[{"measurements":[{"groupId":"OG000","value":"0.9"},{"groupId":"OG001","value":"0.5"}]}]}]},{"type":"SECONDARY","title":"Observed Plasma Trough Concentration (Ctrough) at Steady-State","description":"Summary of plasma palbociclib within-participant mean steady-state trough concentrations.","populationDescription":"Pharmacokinetic analysis set was a subset of AT participants, who were treated with Palbociclib and had at least one measured plasma concentration. Here \"Number Analyzed\" signifies number of participants evaluable for specified rows.","reportingStatus":"POSTED","paramType":"GEOMETRIC_MEAN","dispersionType":"Geometric Coefficient of Variation","unitOfMeasure":"Nanogram per milliliter (ng/mL)","timeFrame":"0 hour (predose) on Day 14 of cycles 1 and 2","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"423"}]}],"classes":[{"title":"Cycle 1 Day 14","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"395"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"70.1","spread":"59"}]}]},{"title":"Cycle 2 Day 14","denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"401"}]}],"categories":[{"measurements":[{"groupId":"OG000","value":"64.2","spread":"82"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline Between Treatment Comparison in Euro Quality of Life (EQ-5D) Index","description":"The EuroQol EQ-5D is a 6-item instrument designed to assess health status in terms of a single index value or utility score. It contains 5 descriptors of current health state (mobility, self-care, usual activities, pain or discomfort, and anxiety or depression) with each dimension having 3 levels of function (1=no problem, 2=some problem, and 3=extreme problem). The scores on the 5 descriptors are summarized to create a single summary score. An overall utility score is calculated based on these domains, with a range score from 0 (worse health scenario) to a maximum of 1.0 (best health scenario).","populationDescription":"Patient Reported Outcome (PRO) Analysis Set is a subset of ITT participants, who had both baseline and at least one follow-up PRO assessment.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Units on a scale","timeFrame":"From Baseline up to 2.5 years","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"437"},{"groupId":"OG001","value":"218"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"0.014","lowerLimit":"0.00","upperLimit":"0.03"},{"groupId":"OG001","value":"-0.010","lowerLimit":"-0.03","upperLimit":"0.01"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.0925","statisticalMethod":"Mixed Models Analysis","statisticalComment":"Analysis based on repeated measures mixed-effects model with an intercept term, treatment, time, treatment-by-time, and baseline as covariate.","paramType":"Mean Difference (Final Values)","paramValue":"0.023","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-0.004","ciUpperLimit":"0.051"}]},{"type":"SECONDARY","title":"Change From Baseline Between Treatment Comparison in Functional Assessment of Cancer Therapy-Breast (FACT-B)","description":"FACT is a modular approach to assess participant health-related quality of life using a 'core' set of questions (FACT-G) as well as a cancer site-specific module. The FACT-G is a 27-item compilation of general questions divided into 4 domains: Physical Well-Being, Social/Family Well-Being, Emotional Well-Being, and Functional Well-Being. The FACT-B consisted of the FACT-G (27-item) and a breast-specific module: a 10-item instrument designed to assess participant concerns relating to breast cancer. For all questions, participants were asked to respond to a five-level scale where 0=not at all, 1=a little bit, 2=somewhat, 3=quite a bit, and 4=very much. FACT-B total score = Physical Well-Being + Social/Family Well-Being + Emotional Well-Being + Functional Well-Being + Breast Cancer Subscale. As each of the items ranges from 0-4, the range of possible scores is 0-144, with 0 being the worst possible score and 144 the best.","populationDescription":"Patient Reported Outcome (PRO) Analysis Set is a subset of ITT participants, who had both baseline and at least one follow-up PRO assessment.","reportingStatus":"POSTED","paramType":"MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Units on a scale","timeFrame":"From Baseline up to 2.5 years","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"439"},{"groupId":"OG001","value":"218"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-0.106","lowerLimit":"-1.42","upperLimit":"1.21"},{"groupId":"OG001","value":"0.219","lowerLimit":"-1.68","upperLimit":"2.12"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.7822","statisticalMethod":"Mixed Models Analysis","statisticalComment":"Analysis based on repeated measures mixed-effects model with an intercept term, treatment, time, treatment-by-time, and baseline as covariate.","paramType":"Mean Difference (Final Values)","paramValue":"-0.325","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"-2.63","ciUpperLimit":"1.98"}]},{"type":"SECONDARY","title":"Percentage of Participants With Treatment-Emergent Adverse Events (TEAEs): All Causalities","description":"An AE was any untoward medical occurrence in a clinical investigation participant administered a product or medical device; the event need not necessarily have a causal relationship with the treatment or usage. SAE was any untoward medical occurrence at any dose that resulted in death; was life-threatening; required hospitalization; resulted in persistent or significant disability or in congenital anomaly/birth defect. TEAE were events that occurred between first dose of study drug and up to 28 days after last dose that were absent before treatment or that worsened relative to pretreatment state. Severity was graded by the National Cancer Institute Common Terminology Criteria for Adverse Events (NCI CTCAE), Version 4.0 as Grade 1 = mild, Grade 2 = moderate, Grade 3 = severe, Grade 4 = life-threatening and Grade 5 = death related to AE. Discontinuation included permanent, temporary discontinuation and dose reduction due to AEs.","populationDescription":"AT population included all participants who received at least 1 dose of study medication, with treatment assignments designated according to actual study treatment received.","reportingStatus":"POSTED","paramType":"NUMBER","unitOfMeasure":"Percentage of participants","timeFrame":"From date of randomization up to 28 days after last dose of study drug (final analysis till study completion, approximately up to 10.51 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"title":"Participants with AEs","categories":[{"measurements":[{"groupId":"OG000","value":"99.1"},{"groupId":"OG001","value":"96.4"}]}]},{"title":"Participants with SAEs","categories":[{"measurements":[{"groupId":"OG000","value":"28.2"},{"groupId":"OG001","value":"17.1"}]}]},{"title":"Participants with Grade 3 or 4 AEs","categories":[{"measurements":[{"groupId":"OG000","value":"83.1"},{"groupId":"OG001","value":"30.2"}]}]},{"title":"Participants with Grade 5 AEs","categories":[{"measurements":[{"groupId":"OG000","value":"3.6"},{"groupId":"OG001","value":"2.3"}]}]},{"title":"Permanently discontinued study due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"4.1"},{"groupId":"OG001","value":"2.3"}]}]},{"title":"Permanently disc. palbociclib/placebo due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"14.4"},{"groupId":"OG001","value":"6.3"}]}]},{"title":"Permanently discontinued letrozole due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"9.2"},{"groupId":"OG001","value":"5.9"}]}]},{"title":"Temporarily disc. palbociclib/placebo due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"79.7"},{"groupId":"OG001","value":"17.1"}]}]},{"title":"Temporarily discontinued letrozole due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"23.0"},{"groupId":"OG001","value":"11.3"}]}]},{"title":"With palbociclib/placebo dose reduction due to AEs","categories":[{"measurements":[{"groupId":"OG000","value":"41.9"},{"groupId":"OG001","value":"2.3"}]}]}]},{"type":"SECONDARY","title":"Overall Survival (OS): Primary Analysis","description":"OS was defined as the time from date of randomization to date of death due to any cause. Participants without survival data beyond the date of their last follow-up were censored on the last date they were known to be alive. Data for this outcome measure was reported at primary analysis.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study medication, regardless of whether participants received study medication or received a different drug from that to which they were randomized.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"From date of randomization until death due to any cause or censored, (assessed up to data cut-off date of 15-Nov-2021, approximately 8.7 years)","groups":[{"id":"OG000","title":"Palbociclib Plus Letrozole","description":"Participants received letrozole 2.5 milligram (mg) orally QD (once daily) combined with palbociclib 125 mg QD for 21 days of every-28-day cycle, followed by 7 days off treatment."},{"id":"OG001","title":"Placebo Plus Letrozole","description":"Participants received letrozole 2.5 mg orally QD combined with placebo QD for 21 days of every-28-day cycle, followed by 7 days off treatment."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"444"},{"groupId":"OG001","value":"222"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"53.9","lowerLimit":"49.8","upperLimit":"60.8"},{"groupId":"OG001","value":"51.2","lowerLimit":"43.7","upperLimit":"58.9"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY_OR_OTHER_LEGACY","pValue":"0.337750","pValueComment":"1-sided p-value from the stratified log-rank test.","statisticalMethod":"Stratified Log Rank","paramType":"Hazard Ratio (HR)","paramValue":"0.956","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.777","ciUpperLimit":"1.177"}]},{"type":"SECONDARY","title":"Overall Survival (OS): Final Analysis","description":"OS was defined as the time from date of randomization to date of death due to any cause. Participants without survival data beyond the date of their last follow-up were censored on the last date they were known to be alive. Data for this outcome measure was reported at final analysis.","populationDescription":"ITT population or full analysis set included all participants who were randomized, with study medication, regardless of whether participants received study medication or received a different drug from that to which they were randomized.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"From date of randomization until death due to any cause or censored (final analysis till study