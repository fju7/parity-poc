{"protocolSection":{"identificationModule":{"nctId":"NCT03036488","orgStudyIdInfo":{"id":"3475-522"},"secondaryIdInfos":[{"id":"173567","type":"REGISTRY","domain":"JAPIC-CTI"},{"id":"MK-3475-522","type":"OTHER","domain":"MSD"},{"id":"KEYNOTE-522","type":"OTHER","domain":"MSD"},{"id":"2022-501382-49-00","type":"REGISTRY","domain":"EU CT"},{"id":"U1111-1280-2361","type":"REGISTRY","domain":"UTN"},{"id":"2016-004740-11","type":"EUDRACT_NUMBER"},{"id":"2016","type":"NIH","link":"https://reporter.nih.gov/quickSearch/2016"}],"organization":{"fullName":"Merck Sharp & Dohme LLC","class":"INDUSTRY"},"briefTitle":"Study of Pembrolizumab (MK-3475) Plus Chemotherapy vs Placebo Plus Chemotherapy as Neoadjuvant Therapy and Pembrolizumab vs Placebo as Adjuvant Therapy in Participants With Triple Negative Breast Cancer (TNBC) (MK-3475-522/KEYNOTE-522)","officialTitle":"A Phase III, Randomized, Double-blind Study to Evaluate Pembrolizumab Plus Chemotherapy vs Placebo Plus Chemotherapy as Neoadjuvant Therapy and Pembrolizumab vs Placebo as Adjuvant Therapy for Triple Negative Breast Cancer (TNBC)"},"statusModule":{"statusVerifiedDate":"2026-10","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2017-03-07","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2025-10-14","type":"ACTUAL"},"completionDateStruct":{"date":"2025-10-14","type":"ACTUAL"},"studyFirstSubmitDate":"2017-01-27","studyFirstSubmitQcDate":"2017-01-27","studyFirstPostDateStruct":{"date":"2017-01-30","type":"ESTIMATED"},"resultsFirstSubmitDate":"2026-10-01","resultsFirstSubmitQcDate":"2026-10-01","resultsFirstPostDateStruct":{"date":"2026-10-22","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-10-01","lastUpdatePostDateStruct":{"date":"2026-10-22","type":"ACTUAL"}},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":1174,"type":"ACTUAL"}}},"resultsSection":{"participantFlowModule":{"preAssignmentDetails":"1174 participants were randomized, 1172 received study treatment. Not completed as indicated in the participant flow refers to trial status.","groups":[{"id":"FG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"FG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"periods":[{"title":"Overall Study","milestones":[{"type":"STARTED","achievements":[{"groupId":"FG000","numSubjects":"784"},{"groupId":"FG001","numSubjects":"390"}]},{"type":"Treated in the Neoadjuvant Phase","achievements":[{"groupId":"FG000","numSubjects":"783"},{"groupId":"FG001","numSubjects":"389"}]},{"type":"Received Surgery","achievements":[{"groupId":"FG000","numSubjects":"768"},{"groupId":"FG001","numSubjects":"381"}]},{"type":"Treated in the Adjuvant Phase","achievements":[{"groupId":"FG000","numSubjects":"588"},{"groupId":"FG001","numSubjects":"331"}]},{"type":"COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"0"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"NOT COMPLETED","achievements":[{"groupId":"FG000","numSubjects":"784"},{"groupId":"FG001","numSubjects":"390"}]}],"dropWithdraws":[{"type":"Withdrawal by Subject","reasons":[{"groupId":"FG000","numSubjects":"12"},{"groupId":"FG001","numSubjects":"8"}]},{"type":"Sponsor Decision","reasons":[{"groupId":"FG000","numSubjects":"652"},{"groupId":"FG001","numSubjects":"295"}]},{"type":"Lost to Follow-up","reasons":[{"groupId":"FG000","numSubjects":"1"},{"groupId":"FG001","numSubjects":"0"}]},{"type":"Death","reasons":[{"groupId":"FG000","numSubjects":"119"},{"groupId":"FG001","numSubjects":"87"}]}]}]},"baselineCharacteristicsModule":{"populationDescription":"The baseline analysis population consisted of all randomized participants.","groups":[{"id":"BG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"BG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"BG002","title":"Total","description":"Total of all reporting groups"}],"denoms":[{"units":"Participants","counts":[{"groupId":"BG000","value":"784"},{"groupId":"BG001","value":"390"},{"groupId":"BG002","value":"1174"}]}],"measures":[{"title":"Age, Continuous","paramType":"MEAN","dispersionType":"STANDARD_DEVIATION","unitOfMeasure":"Years","classes":[{"categories":[{"measurements":[{"groupId":"BG000","value":"49.2","spread":"11.8"},{"groupId":"BG001","value":"49.1","spread":"11.9"},{"groupId":"BG002","value":"49.1","spread":"11.8"}]}]}]},{"title":"Sex: Female, Male","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Female","measurements":[{"groupId":"BG000","value":"783"},{"groupId":"BG001","value":"390"},{"groupId":"BG002","value":"1173"}]},{"title":"Male","measurements":[{"groupId":"BG000","value":"1"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"1"}]}]}]},{"title":"Ethnicity (NIH/OMB)","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Hispanic or Latino","measurements":[{"groupId":"BG000","value":"85"},{"groupId":"BG001","value":"39"},{"groupId":"BG002","value":"124"}]},{"title":"Not Hispanic or Latino","measurements":[{"groupId":"BG000","value":"616"},{"groupId":"BG001","value":"307"},{"groupId":"BG002","value":"923"}]},{"title":"Unknown or Not Reported","measurements":[{"groupId":"BG000","value":"83"},{"groupId":"BG001","value":"44"},{"groupId":"BG002","value":"127"}]}]}]},{"title":"Race (NIH/OMB)","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"American Indian or Alaska Native","measurements":[{"groupId":"BG000","value":"14"},{"groupId":"BG001","value":"7"},{"groupId":"BG002","value":"21"}]},{"title":"Asian","measurements":[{"groupId":"BG000","value":"149"},{"groupId":"BG001","value":"89"},{"groupId":"BG002","value":"238"}]},{"title":"Native Hawaiian or Other Pacific Islander","measurements":[{"groupId":"BG000","value":"1"},{"groupId":"BG001","value":"0"},{"groupId":"BG002","value":"1"}]},{"title":"Black or African American","measurements":[{"groupId":"BG000","value":"38"},{"groupId":"BG001","value":"15"},{"groupId":"BG002","value":"53"}]},{"title":"White","measurements":[{"groupId":"BG000","value":"504"},{"groupId":"BG001","value":"242"},{"groupId":"BG002","value":"746"}]},{"title":"More than one race","measurements":[{"groupId":"BG000","value":"13"},{"groupId":"BG001","value":"6"},{"groupId":"BG002","value":"19"}]},{"title":"Unknown or Not Reported","measurements":[{"groupId":"BG000","value":"65"},{"groupId":"BG001","value":"31"},{"groupId":"BG002","value":"96"}]}]}]},{"title":"Nodal Status","description":"Participants were stratified based on their nodal status (positive vs negative for nodal involvement with tumor). Negative indicated no nodal involvement and positive indicated involvement of one or more lymph nodes.","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Positive","measurements":[{"groupId":"BG000","value":"405"},{"groupId":"BG001","value":"200"},{"groupId":"BG002","value":"605"}]},{"title":"Negative","measurements":[{"groupId":"BG000","value":"379"},{"groupId":"BG001","value":"190"},{"groupId":"BG002","value":"569"}]}]}]},{"title":"Tumor Size","description":"Participants were stratified by tumor size (T1/T2 or T3/T4) according to the American Joint Committee on Cancer (AJCC) staging system with the lowest (\"best\") score being T1 and the highest (\"worst\") score being T4. The scale measures the size and/or extent of the main tumor. The higher the number after the T, the larger the tumor or the more it has grown into nearby tissues. T1/T2 represented smaller tumors with no spread or less spread into surrounding tissues and T3/T4 represented larger tumors and tumors that had spread more into surrounding tissues.","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"T1/T2","measurements":[{"groupId":"BG000","value":"580"},{"groupId":"BG001","value":"290"},{"groupId":"BG002","value":"870"}]},{"title":"T3/T4","measurements":[{"groupId":"BG000","value":"204"},{"groupId":"BG001","value":"100"},{"groupId":"BG002","value":"304"}]}]}]},{"title":"Choice of Carboplatin","description":"Participants were stratified by carboplatin dosing regimen. Dosing regimen options were either weekly or every 3 weeks (Q3W)","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","classes":[{"categories":[{"title":"Every 3 Weeks (Q3W)","measurements":[{"groupId":"BG000","value":"335"},{"groupId":"BG001","value":"167"},{"groupId":"BG002","value":"502"}]},{"title":"Weekly","measurements":[{"groupId":"BG000","value":"449"},{"groupId":"BG001","value":"223"},{"groupId":"BG002","value":"672"}]}]}]}]},"outcomeMeasuresModule":{"outcomeMeasures":[{"type":"SECONDARY","title":"Overall Survival (OS) in All Participants","description":"OS was defined as the time from randomization to death due to any cause.","populationDescription":"The analysis population consisted of all randomized participants.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"Up to approximately 102 months","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"784"},{"groupId":"OG001","value":"390"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."},{"groupId":"OG001","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"This protocol-specified final analysis occurred after an interim analysis that met the secondary endpoint of OS. No formal statistical testing was performed for this updated analysis, and therefore, the p-value is nominal.","nonInferiorityType":"SUPERIORITY","pValue":".0007538","pValueComment":"One-sided p-value based on log-rank test stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly).","statisticalMethod":"Log Rank","paramType":"Hazard Ratio (HR)","paramValue":"0.64","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.49","ciUpperLimit":"0.85","estimateComment":"Based on Cox regression model with Efron's method of tie handling with treatment as a covariate stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"pCR Rate Using an Alternative Definition, ypT0 ypN0 (i.e., no Invasive or Noninvasive Residual in Breast or Nodes) at the Time of Definitive Surgery in All Participants","description":"pCR rate (ypT0 ypN0) was defined as the percentage of participants without residual invasive and in situ cancer on hematoxylin and eosin evaluation of the complete resected breast specimen and all sampled regional lymph nodes following completion of neoadjuvant systemic therapy by current AJCC staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"669"},{"groupId":"OG001","value":"333"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"58.7","lowerLimit":"54.9","upperLimit":"62.5"},{"groupId":"OG001","value":"49.5","lowerLimit":"44.1","upperLimit":"55.1"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Difference in Percentage","paramValue":"9.1","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2.6","ciUpperLimit":"15.5","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"pCR Rate Using an Alternative Definition, ypT0 ypN0 (i.e., no Invasive or Noninvasive Residual in Breast or Nodes) at the Time of Definitive Surgery in Participants With Programmed Death Ligand 1 (PD-L1) Positive Tumors (Combined Positive Score [CPS] ≥ 1)","description":"pCR rate (ypT0 ypN0) was defined as the percentage of participants without residual invasive and in situ cancer on hematoxylin and eosin evaluation of the complete resected breast specimen and all sampled regional lymph nodes following completion of neoadjuvant systemic therapy by current AJCC staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of participants with PD-L1 positive tumors (CPS ≥ 1) within the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"560"},{"groupId":"OG001","value":"271"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"62.0","lowerLimit":"57.8","upperLimit":"66.0"},{"groupId":"OG001","value":"52.4","lowerLimit":"46.3","upperLimit":"58.5"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Difference in Percentage","paramValue":"9.8","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2.7","ciUpperLimit":"16.9","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"pCR Rate Using the Definition of ypT0/Tis ypN0 (i.e., no Invasive Residual in Breast or Nodes; Noninvasive Breast Residuals Allowed) at the Time of Definitive Surgery in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"pCR rate (ypT0/Tis ypN0) was defined as the percentage of participants without residual invasive cancer on hematoxylin and eosin evaluation of the complete resected breast specimen and all sampled regional lymph nodes following completion of neoadjuvant systemic therapy by current AJCC staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of participants with PD-L1 positive tumors (CPS ≥ 1) within the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"560"},{"groupId":"OG001","value":"271"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"67.1","lowerLimit":"63.1","upperLimit":"71.0"},{"groupId":"OG001","value":"58.3","lowerLimit":"52.2","upperLimit":"64.2"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Difference in Percentage","paramValue":"9.0","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2.1","ciUpperLimit":"16.0","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"EFS in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"EFS was defined as the time from randomization to the first occurrence of any of the following events: progression of disease that precludes definitive surgery, local or distant recurrence, second primary malignancy, as assessed by Investigator, or death due to any cause.","populationDescription":"The analysis population consisted of all randomized participants with PD-L1 positive tumors (CPS ≥ 1).","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"Up to approximately 102 months","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"656"},{"groupId":"OG001","value":"316"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."},{"groupId":"OG001","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Hazard Ratio (HR)","paramValue":"0.70","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.54","ciUpperLimit":"0.91","estimateComment":"Based on Cox regression model with Efron's method of tie handling with treatment as a covariate stratified by nodal status (positive vs. negative),tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"pCR Rate Using an Alternative Definition, ypT0/Tis (i.e., Absence of Invasive Cancer in the Breast Irrespective of Ductal Carcinoma in Situ or Nodal Involvement) at the Time of Definitive Surgery in All Participants","description":"pCR rate (ypT0/Tis) was defined as the percentage of participants without invasive cancer in the breast irrespective of ductal carcinoma in situ or nodal involvement following completion of neoadjuvant systemic therapy by current AJCC staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"669"},{"groupId":"OG001","value":"333"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"66.8","lowerLimit":"63.1","upperLimit":"70.4"},{"groupId":"OG001","value":"57.4","lowerLimit":"51.8","upperLimit":"62.7"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Difference in Percentage","paramValue":"9.3","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"3.1","ciUpperLimit":"15.7","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"pCR Rate Using an Alternative Definition, ypT0/Tis (i.e., Absence of Invasive Cancer in the Breast Irrespective of Ductal Carcinoma in Situ or Nodal Involvement) at the Time of Definitive Surgery in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"pCR rate (ypT0/Tis) was defined as the percentage of participants without invasive cancer in the breast irrespective of ductal carcinoma in situ or nodal involvement following completion of neoadjuvant systemic therapy by current AJCC staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of participants with PD-L1 positive tumors (CPS ≥ 1) within the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"560"},{"groupId":"OG001","value":"271"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"70.0","lowerLimit":"66.0","upperLimit":"73.8"},{"groupId":"OG001","value":"61.3","lowerLimit":"55.2","upperLimit":"67.1"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Difference in Percentage","paramValue":"8.8","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2.1","ciUpperLimit":"15.7","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)"}]},{"type":"SECONDARY","title":"Overall Survival (OS) in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"OS was defined as the time from randomization to death due to any cause.","populationDescription":"The analysis population consistent of all randomized participants with PD-L1 positive tumors (CPS ≥ 1).","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"Up to approximately 102 months","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"656"},{"groupId":"OG001","value":"316"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."},{"groupId":"OG001","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"OTHER","paramType":"Hazard Ratio (HR)","paramValue":"0.69","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.51","ciUpperLimit":"0.95","estimateComment":"Based on Cox regression model with Efron's method of tie handling with treatment as a covariate stratified by nodal status (positive vs. negative),tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"Number of Participants Who Experienced an Adverse Event (AE)","description":"An AE was any untoward medical occurrence in a participant administered a pharmaceutical product which does not have to have a causal relationship with this treatment. An AE can be any unfavorable and unintended sign (including abnormal laboratory finding), symptom, or disease temporally associated with the use of a medicinal product or protocol-specified procedure, whether or not considered related to the product or procedure. Any worsening (any clinically significant adverse change in frequency and/or intensity) of a pre-existing condition that is temporally associated with the use of the Sponsor's product was an AE. The number of participants who experienced an AE was reported. AEs were reported for the neoadjuvant phase, adjuvant phase, and combined phases. Each participant is counted a single time for each applicable adverse event per treatment phase (i.e. Neoadjuvant, Adjuvant, Combined).","populationDescription":"The analysis population consisted of all randomized participants who received at least one study treatment.","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"Up to approximately 107 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG004","title":"Pembrolizumab + Chemotherapy / Pembrolizumab (Neoadjuvant and Adjuvant Combined Phases)","description":"The Pembrolizumab + Chemotherapy Neoadjuvant Phase plus the Pembrolizumab Adjuvant Phase combined."},{"id":"OG005","title":"Placebo + Chemotherapy / Placebo (Neoadjuvant and Adjuvant Combined Phases)","description":"The Placebo + Chemotherapy Neoadjuvant Phase plus the Placebo Adjuvant Phase combined."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"783"},{"groupId":"OG001","value":"389"},{"groupId":"OG002","value":"588"},{"groupId":"OG003","value":"331"},{"groupId":"OG004","value":"783"},{"groupId":"OG005","value":"389"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"777"},{"groupId":"OG001","value":"389"},{"groupId":"OG002","value":"541"},{"groupId":"OG003","value":"294"},{"groupId":"OG004","value":"777"},{"groupId":"OG005","value":"389"}]}]}]},{"type":"SECONDARY","title":"Number of Participants Who Discontinued Study Treatment Due to an AE","description":"An AE was any untoward medical occurrence in a participant administered a pharmaceutical product which does not have to have a causal relationship with this treatment. An AE can be any unfavorable and unintended sign (including abnormal laboratory finding), symptom, or disease temporally associated with the use of a medicinal product or protocol-specified procedure, whether or not considered related to the product or procedure. Any worsening (clinically significant adverse change in frequency and/or intensity) of a pre-existing condition that is temporally associated with the use of the Sponsor's product was an AE. The number of participants who discontinued study treatment due to an AE was reported for the neoadjuvant phase, adjuvant phase, and combined phases. Each participant is counted a single time for each applicable event per treatment phase (i.e. Neoadjuvant, Adjuvant, Combined).","populationDescription":"The analysis population consisted of all randomized participants who received at least one study treatment.","reportingStatus":"POSTED","paramType":"COUNT_OF_PARTICIPANTS","unitOfMeasure":"Participants","timeFrame":"Up to approximately 95 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + paclitaxel weekly + carboplatin (weekly or Q3W) x 4 cycles, followed by placebo + (doxorubicin OR epirubicin) + cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG004","title":"Pembrolizumab + Chemotherapy / Pembrolizumab (Neoadjuvant and Adjuvant Combined Phases)","description":"The Pembrolizumab + Chemotherapy Neoadjuvant Phase plus the Pembrolizumab Adjuvant Phase combined."},{"id":"OG005","title":"Placebo + Chemotherapy / Placebo (Neoadjuvant and Adjuvant Combined Phases)","description":"The Placebo + Chemotherapy Neoadjuvant Phase plus the Placebo Adjuvant Phase combined."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"783"},{"groupId":"OG001","value":"389"},{"groupId":"OG002","value":"588"},{"groupId":"OG003","value":"331"},{"groupId":"OG004","value":"783"},{"groupId":"OG005","value":"389"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"204"},{"groupId":"OG001","value":"53"},{"groupId":"OG002","value":"32"},{"groupId":"OG003","value":"8"},{"groupId":"OG004","value":"233"},{"groupId":"OG005","value":"60"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in European Organisation for Research and Treatment of Cancer (EORTC) Quality of Life Questionnaire-Core 30 (QLQ-C30) Score in All Participants","description":"The EORTC QLQ-C30 assesses quality of life in cancer patients and includes 30 questions: 1 global scale; 5 functional scales (physical, role, cognitive, emotional, social); 3 symptom scales (fatigue, nausea, pain); 6 symptoms (dyspnea, appetite loss, insomnia, constipation, diarrhea); \\& financial impact. Items are scored on a 4-point scale (1=not at all, 2=a little, 3=quite a bit, 4=very much). Scale scores are standardized to 0-100. Higher global and functional scores indicate better functioning, while higher symptom scores indicate worse symptoms. Results were presented separately for the neoadjuvant and adjuvant phases, with side-by-side review of phase-specific outputs. A combined phase analysis was not presented because the phases represent distinct clinical settings with different baselines; the adjuvant population is a subset of the neoadjuvant population; and pooling data would introduce substantial missingness, limiting clinical interpretability of the results.","populationDescription":"The analysis population consisted of all participants who had at least 1 EORTC QLQ-C30 patient reported outcome (PRO) assessment available and had received at least 1 dose of study treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Score on a scale","timeFrame":"Neoadjuvant: Baseline and Week 21; Adjuvant: Baseline and Week 24","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"762"},{"groupId":"OG001","value":"383"},{"groupId":"OG002","value":"539"},{"groupId":"OG003","value":"308"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-11.24","lowerLimit":"-12.82","upperLimit":"-9.66"},{"groupId":"OG001","value":"-10.20","lowerLimit":"-12.30","upperLimit":"-8.10"},{"groupId":"OG002","value":"2.47","lowerLimit":"1.05","upperLimit":"3.88"},{"groupId":"OG003","value":"2.88","lowerLimit":"1.05","upperLimit":"4.71"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in EORTC QLQ-C30 Score in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"The EORTC QLQ-C30 assesses quality of life in cancer patients and includes 30 questions: 1 global scale; 5 functional scales (physical, role, cognitive, emotional, social); 3 symptom scales (fatigue, nausea, pain); 6 symptoms (dyspnea, appetite loss, insomnia, constipation, diarrhea); \\& financial impact. Items are scored on a 4-point scale (1=not at all, 2=a little, 3=quite a bit, 4=very much). Scale scores are standardized to 0-100. Higher global and functional scores indicate better functioning, while higher symptom scores indicate worse symptoms. Results were presented separately for the neoadjuvant and adjuvant phases, with side-by-side review of phase-specific outputs. A combined phase analysis was not presented because the phases represent distinct clinical settings with different baselines; the adjuvant population is a subset of the neoadjuvant population; and pooling data would introduce substantial missingness, limiting clinical interpretability of the results.","populationDescription":"The analysis population consisted of participants with PD-L1 positive tumors (CPS ≥ 1) who had at least 1 EORTC QLQ-C30 PRO assessment available and had received at least 1 dose of study treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Score on a scale","timeFrame":"Neoadjuvant: Baseline and Week 21; Adjuvant: Baseline and Week 24","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"635"},{"groupId":"OG001","value":"312"},{"groupId":"OG002","value":"444"},{"groupId":"OG003","value":"256"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-11.63","lowerLimit":"-13.35","upperLimit":"-9.91"},{"groupId":"OG001","value":"-10.95","lowerLimit":"-13.25","upperLimit":"-8.64"},{"groupId":"OG002","value":"1.88","lowerLimit":"0.31","upperLimit":"3.46"},{"groupId":"OG003","value":"2.49","lowerLimit":"0.47","upperLimit":"4.51"}]}]}]},{"type":"SECONDARY","title":"Change From Baseline in EORTC Breast Cancer-Specific Quality of Life Questionnaire (QLQ-BR23) Breast Symptoms Score in All Participants","description":"The EORTC QLQ-BR23 is a breast-specific module of the EORTC QLQ. It includes 23 items composed of 4 functional scales (body image, sexual functioning, sexual enjoyment, future perspective) and 4 symptom scales (systemic therapy side effects, breast symptoms, arm symptoms and upset by hair loss). Individual responses are given on a 4-point scale (1=Not at All to 4=Very Much). Scores for each scale are standardized into a range of 0 to 100. A higher score on the symptom scale shows a higher (\"worse\") level of symptoms. Results were presented separately for the neoadjuvant and adjuvant phases, with side-by-side review of phase-specific outputs. A combined phase analysis was not presented because the phases represent distinct clinical settings with different baselines; the adjuvant population is a subset of the neoadjuvant population; and pooling data would introduce substantial missingness, limiting clinical interpretability of the results.","populationDescription":"The analysis population consisted of all participants who had at least 1 QLQ-BR23 PRO assessment available and had received at least 1 dose of study treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Score on a scale","timeFrame":"Neoadjuvant: Baseline and Week 21; Adjuvant: Baseline and Week 24","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"759"},{"groupId":"OG001","value":"382"},{"groupId":"OG002","value":"538"},{"groupId":"OG003","value":"306"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-9.92","lowerLimit":"-11.34","upperLimit":"-8.49"},{"groupId":"OG001","value":"-9.78","lowerLimit":"-11.53","upperLimit":"-8.03"},{"groupId":"OG002","value":"-5.73","lowerLimit":"-7.32","upperLimit":"-4.15"},{"groupId":"OG003","value":"-6.02","lowerLimit":"-8.04","upperLimit":"-4.01"}]}]}]},{"type":"PRIMARY","title":"Pathological Complete Response (pCR) Rate Using the Definition of ypT0/Tis ypN0 (i.e., no Invasive Residual in Breast or Nodes; Noninvasive Breast Residuals Allowed) as Assessed at the Time of Definitive Surgery in All Participants","description":"pCR rate (ypT0/Tis ypN0) was defined as the percentage of participants without residual invasive cancer on hematoxylin and eosin evaluation of the complete resected breast specimen and all sampled regional lymph nodes following completion of neoadjuvant systemic therapy by current American Joint Committee on Cancer (AJCC) staging criteria assessed by the local pathologist at the time of definitive surgery.","populationDescription":"The analysis population consisted of the first 1002 participants randomly assigned to study treatment.","reportingStatus":"POSTED","paramType":"NUMBER","dispersionType":"95% Confidence Interval","unitOfMeasure":"Percentage of Participants","timeFrame":"Up to approximately 27-30 weeks","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"669"},{"groupId":"OG001","value":"333"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"64.0","lowerLimit":"60.2","upperLimit":"67.6"},{"groupId":"OG001","value":"54.7","lowerLimit":"49.1","upperLimit":"60.1"}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"nonInferiorityType":"SUPERIORITY","pValue":"0.00221","pValueComment":"One-sided p-value.","statisticalMethod":"Stratified Miettinen & Nurminen","paramType":"Difference in Percentage","paramValue":"9.2","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"2.8","ciUpperLimit":"15.6","estimateComment":"Based on Miettinen \\& Nurminen method stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"PRIMARY","title":"Event-free Survival (EFS) in All Participants","description":"EFS was defined as the time from randomization to the first occurrence of any of the following events: progression of disease that precludes definitive surgery, local or distant recurrence, second primary malignancy, as assessed by Investigator, or death due to any cause.","populationDescription":"The analysis population consisted of all randomized participants.","reportingStatus":"POSTED","paramType":"MEDIAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Months","timeFrame":"Up to approximately 102 months","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG001","title":"Placebo + Chemotherapy","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal. Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"784"},{"groupId":"OG001","value":"390"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."},{"groupId":"OG001","value":"NA","lowerLimit":"NA","upperLimit":"NA","comment":"NA = Median, upper limit, lower limit not reached at time of data cut-off due to insufficient number of participants with an event."}]}]}],"analyses":[{"groupIds":["OG000","OG001"],"groupDescription":"This protocol-specified final analysis occurred after an interim analysis that met the primary endpoint of EFS. No formal statistical testing was performed for this updated analysis, and therefore, the p-value is nominal.","nonInferiorityType":"SUPERIORITY","pValue":".0005943","pValueComment":"One-sided p-value based on log-rank test stratified by nodal status (positive vs negative), tumor size (T1/T2 vs T3/T4) and choice of carboplatin (Q3W vs Weekly).","statisticalMethod":"Log Rank","paramType":"Hazard Ratio (HR)","paramValue":"0.68","ciPctValue":"95","ciNumSides":"TWO_SIDED","ciLowerLimit":"0.54","ciUpperLimit":"0.86","estimateComment":"Based on Cox regression model with Efron's method of tie handling with treatment as a covariate stratified by nodal status (positive vs. negative), tumor size (T1/T2 vs. T3/T4) and choice of carboplatin (Q3W vs. Weekly)."}]},{"type":"SECONDARY","title":"Change From Baseline in EORTC QLQ-BR23 Breast Symptoms Score in Participants With PD-L1 Positive Tumors (CPS ≥ 1)","description":"The EORTC QLQ-BR23 is a breast-specific module of the EORTC QLQ. It includes 23 items composed of 4 functional scales (body image, sexual functioning, sexual enjoyment, future perspective) and 4 symptom scales (systemic therapy side effects, breast symptoms, arm symptoms and upset by hair loss). Individual responses are given on a 4-point scale (1=Not at All to 4=Very Much). Scores for each scale are standardized into a range of 0 to 100. A higher score on the symptom scale shows a higher (\"worse\") level of symptoms. Results were presented separately for the neoadjuvant and adjuvant phases, with side-by-side review of phase-specific outputs. A combined phase analysis was not presented because the phases represent distinct clinical settings with different baselines; the adjuvant population is a subset of the neoadjuvant population; and pooling data would introduce substantial missingness, limiting clinical interpretability of the results.","populationDescription":"The analysis population consisted of participants with PD-L1 positive tumors (CPS ≥ 1) who had at least 1 QLQ-BR23 PRO assessment available and had received at least 1 dose of study treatment.","reportingStatus":"POSTED","paramType":"LEAST_SQUARES_MEAN","dispersionType":"95% Confidence Interval","unitOfMeasure":"Score on a scale","timeFrame":"Neoadjuvant: Baseline and Week 21; Adjuvant: Baseline and Week 24","groups":[{"id":"OG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by placebo + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal."},{"id":"OG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21 days."},{"id":"OG003","title":"Placebo (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of placebo Q3W as adjuvant therapy. Each cycle was 21 days."}],"denoms":[{"units":"Participants","counts":[{"groupId":"OG000","value":"632"},{"groupId":"OG001","value":"311"},{"groupId":"OG002","value":"443"},{"groupId":"OG003","value":"254"}]}],"classes":[{"categories":[{"measurements":[{"groupId":"OG000","value":"-9.43","lowerLimit":"-11.03","upperLimit":"-7.84"},{"groupId":"OG001","value":"-9.19","lowerLimit":"-11.17","upperLimit":"-7.21"},{"groupId":"OG002","value":"-5.47","lowerLimit":"-7.26","upperLimit":"-3.67"},{"groupId":"OG003","value":"-6.27","lowerLimit":"-8.53","upperLimit":"-4.00"}]}]}]}]},"adverseEventsModule":{"frequencyThreshold":"5","timeFrame":"Up to approximately 102 months.","description":"All-Cause Mortality = all randomized participants. AEs = all randomized participants with at least 1 study treatment. Per protocol, MedDRA terms Neoplasm progression, Malignant neoplasm progression \\& Disease progression unrelated to study treatment were excluded. Per protocol, AEs were collected up to 30 days and Serious AEs up to 90 days of the last treatment received. Each participant is counted a single time for each applicable AE per treatment phase (i.e. Neoadjuvant, Adjuvant, Combined).","eventGroups":[{"id":"EG000","title":"Pembrolizumab + Chemotherapy (Neoadjuvant Phase)","description":"Participants received 200 mg pembrolizumab every 3 weeks (Q3W) + 80 mg/m\\^2 paclitaxel weekly + carboplatin (AUC1.5 weekly or AUC5 Q3W) x 4 cycles, followed by 200 mg pembrolizumab Q3W + (60 mg/m\\^2 doxorubicin OR 90 mg/m\\^2 epirubicin) + 600 mg/m\\^2 cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to adverse events (AEs), clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal.","deathsNumAffected":9,"deathsNumAtRisk":783,"seriousNumAffected":315,"seriousNumAtRisk":783,"otherNumAffected":774,"otherNumAtRisk":783},{"id":"EG001","title":"Placebo + Chemotherapy (Neoadjuvant Phase)","description":"Participants received placebo (normal saline solution) Q3W + paclitaxel weekly + carboplatin (weekly or Q3W) x 4 cycles, followed by placebo + (doxorubicin OR epirubicin) + cyclophosphamide Q3W x 4 cycles as neoadjuvant therapy prior to surgery. Each cycle was 21 days. After completion or early discontinuation of neoadjuvant treatment, participants underwent definitive surgery per local standard of care. A subset of participants discontinued in the neoadjuvant phase due to AEs, clinical progression, physician decision, progressive disease, relapse/recurrence, or withdrawal.","deathsNumAffected":2,"deathsNumAtRisk":389,"seriousNumAffected":101,"seriousNumAtRisk":389,"otherNumAffected":389,"otherNumAtRisk":389},{"id":"EG002","title":"Pembrolizumab (Adjuvant Phase)","description":"Following surgery, participants received 9 cycles of 200 mg pembrolizumab Q3W as adjuvant therapy. Each cycle was 21days.","deathsNumAffected":7,"deathsNumAtRisk":588,"seriousNumAffected":41,"seriousNumAtRisk":588,"otherNumAffect