<bold>(N=18,325)</bold>
</td><td align="left" valign="top" content-type="entry xxxx-borders shading" rowspan="1" colspan="1"/><td align="left" valign="top" content-type="entry xxxr-borders shading" rowspan="1" colspan="1"/></tr><tr content-type="row"><td align="left" valign="top" content-type="entry xxlx-borders hanging01 shading" rowspan="1" colspan="1">Covid-19 occurrence at least 7 days after the second dose in participants without evidence of infection</td><td align="center" valign="top" content-type="entry xxxx-borders shading" rowspan="1" colspan="1">8</td><td valign="top" content-type="entry xxxx-borders shading" align="char" char="(" rowspan="1" colspan="1">2.214 (17,411)</td><td align="center" valign="top" content-type="entry xxxx-borders shading" rowspan="1" colspan="1">162</td><td valign="top" content-type="entry xxxx-borders shading" align="char" char="(" rowspan="1" colspan="1">2.222 (17,511)</td><td valign="top" content-type="entry xxxx-borders shading" align="char" char="(" rowspan="1" colspan="1">95.0 (90.3–97.6)</td><td align="center" valign="top" content-type="entry xxxr-borders shading" rowspan="1" colspan="1">&gt;0.9999</td></tr><tr content-type="row"><td align="left" valign="top" content-type="entry xxlx-borders hanging01" rowspan="1" colspan="1"/><td align="center" valign="top" colspan="2" content-type="entry xxxx-borders" rowspan="1">
