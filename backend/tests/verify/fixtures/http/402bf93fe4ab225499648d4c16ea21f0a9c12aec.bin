<article-title>Prospects for a safe COVID-19 vaccine.</article-title>
<source>Sci Transl Med</source>
<year>2020</year>;<volume>12</volume>(<issue>568</issue>):<fpage>eabe0948</fpage>-<lpage>eabe0948</lpage>.<pub-id pub-id-type="pmid">33077678</pub-id><pub-id pub-id-type="doi" assigning-authority="pmc">10.1126/scitranslmed.abe0948</pub-id></mixed-citation></ref><ref id="r12"><label>12</label><mixed-citation publication-type="journal"><string-name name-style="western"><surname>Cowling</surname>
